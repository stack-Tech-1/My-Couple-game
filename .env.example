# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for auth redirects, invite links and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional, disabled when empty). Provider-agnostic: "console" | "plausible" | ""
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Postgres connection string, used only by npm run db:migrate (Settings -> Database -> Session pooler)
SUPABASE_DB_URL=

# Announcement emails from the admin (optional; the option stays off until both are set).
# Gmail: your address and a 16-character App Password (Google Account -> Security -> App passwords).
SMTP_USER=
SMTP_PASS=
# Only needed for a provider other than Gmail (defaults: smtp.gmail.com, 465)
SMTP_HOST=
SMTP_PORT=
# Optional display name/address, e.g. "Amah <hello@yourdomain.com>"
EMAIL_FROM=
